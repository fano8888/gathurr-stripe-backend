# Copy this file to .env and fill in real values. Never commit .env.

# From https://dashboard.stripe.com/test/apikeys — use the SECRET key (starts sk_test_ / sk_live_).
# This must never appear in any client-side code, including the Gathurr artifact.
STRIPE_SECRET_KEY=sk_test_...

# From the Stripe Dashboard once you create a webhook endpoint pointing at
# https://your-backend-domain.com/api/webhook (starts whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_...

# Comma-separated list of origins allowed to call this backend from a browser.
# Claude artifacts are served from claude.site / claude.ai — add the exact
# origin shown in your browser's address bar when the app is open.
ALLOWED_ORIGINS=https://claude.site

PORT=4242
